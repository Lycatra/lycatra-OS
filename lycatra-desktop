#!/usr/bin/env python3
# Launcher keystrokes use the warm daemon without importing setup and packaging.
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
if (
    __name__ == "__main__"
    and len(sys.argv) in (4, 5)
    and sys.argv[1] == "query"
    and sys.argv[2] in ("lexical", "semantic")
    and (len(sys.argv) == 4 or sys.argv[3] == "--")
):
    import json
    from client import local_query

    try:
        print(json.dumps(local_query(sys.argv[2], sys.argv[-1])))
        raise SystemExit(0)
    except (OSError, ValueError):
        pass  # The regular CLI can still read filenames while the service restarts.

import argparse
import contextlib
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import manage
import menu
import models
import preferences
import search


def setup_model(name=models.DEFAULT):
    import urllib.request
    import venv

    base = search.MODEL
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    runtime = base / "venv"
    if not (runtime / "bin/python").exists():
        venv.create(runtime, with_pip=True)
    subprocess.run(
        [
            str(runtime / "bin/python"),
            "-m",
            "pip",
            "install",
            "--only-binary=:all:",
            "-r",
            str(manage.ROOT / "requirements.lock"),
        ],
        check=True,
    )
    spec = models.MODELS[name]
    dest = models.folder(base, name)
    dest.mkdir(mode=0o700, exist_ok=True)
    for remote, filename, digest in [
        (spec["onnx"], "model.onnx", spec["model_hash"]),
        ("tokenizer.json", "tokenizer.json", spec["vocabulary_sha256"]),
    ]:
        target = dest / filename
        if target.exists():
            with target.open("rb") as f:
                if hashlib.file_digest(f, "sha256").hexdigest() == digest:
                    continue
        with tempfile.NamedTemporaryFile(dir=dest, delete=False) as f:
            tmp = Path(f.name)
            try:
                with urllib.request.urlopen(
                    f"https://huggingface.co/{spec['repo']}/resolve/{spec['revision']}/{remote}",
                    timeout=60,
                ) as stream:
                    shutil.copyfileobj(stream, f)
                f.flush()
                with tmp.open("rb") as verify:
                    if hashlib.file_digest(verify, "sha256").hexdigest() != digest:
                        raise ValueError("Model checksum mismatch")
                os.replace(tmp, target)
            finally:
                tmp.unlink(missing_ok=True)


def main():
    os.umask(0o077)
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="op", required=True)
    for op in ("inspect", "plan", "apply", "verify", "update", "remove", "rollback"):
        cmd = sub.add_parser(op)
        cmd.add_argument("components", nargs="*")
        cmd.add_argument(
            "--stage",
            action="store_true",
            help="Materialize files without activating desktop services",
        )
        cmd.add_argument("--json", action="store_true")
        if op == "update":
            cmd.add_argument("--channel", choices=["stable", "preview"])
        if op in ("apply", "update"):
            cmd.add_argument(
                "--install-deps",
                action="store_true",
                help="Install missing system packages through Omarchy",
            )
    sub.add_parser("catalog")
    for op in ["model-install", "model-index", "model-prepare"]:
        sub.add_parser(op).add_argument(
            "model", nargs="?", default=models.DEFAULT, choices=models.MODELS
        )
    sub.add_parser("settings")
    sub.add_parser("serve")
    sub.add_parser("menu-compat")
    sub.add_parser("session-watch")
    sub.add_parser("status")
    for op in ("pause", "resume", "reindex", "webapp"):
        sub.add_parser(op)
    q = sub.add_parser("query")
    q.add_argument("stage", choices=["lexical", "semantic", "wiki"])
    q.add_argument("phrase")
    sub.add_parser("open").add_argument("result", nargs=2)
    conf = sub.add_parser("configure")
    for key in preferences.SWITCHES:
        conf.add_argument("--" + key.replace("_", "-"), dest=key, choices=["on", "off"])
    conf.add_argument("--root", action="append")
    conf.add_argument("--exclude", action="append")
    a = p.parse_args()
    if a.op == "menu-compat":
        if (
            not menu.SOURCE.is_dir()
            or hashlib.sha256((menu.SOURCE / "Menu.qml").read_bytes()).hexdigest()
            != menu.SUPPORTED
        ):
            if manage.plugin_state().get("lycatra.menu"):
                manage.run("omarchy", "plugin", "disable", "lycatra.menu")
            return {"menu": "stock", "reason": "installed Omarchy menu changed"}
        return {"menu": "compatible"}
    if a.op == "update":
        receipt = manage.read(manage.RECEIPT, {})
        selected = manage.names(set(receipt.get("selected", [])) | set(a.components))
        if not selected:
            raise ValueError("Select a component before updating.")
        channel = a.channel or (
            "preview" if "-preview." in receipt.get("tag", "") else "stable"
        )
        args = [str(manage.ROOT / "release/bootstrap.sh"), *selected]
        if a.stage:
            args.append("--stage")
        if a.install_deps:
            args.append("--install-deps")
        env = {**os.environ, "LYCATRA_DESKTOP_CHANNEL": channel}
        env.pop("LYCATRA_DESKTOP_RELEASE", None)
        os.execve(args[0], args, env)
    if a.op == "catalog":
        return manage.CAT
    if a.op == "model-install":
        setup_model(a.model)
        return {"model": a.model}
    if a.op == "settings":
        return preferences.show()
    if a.op == "model-prepare":
        return preferences.prepare(a.model)
    if a.op == "model-index":
        return preferences.build_index(a.model)
    if a.op == "query":
        return search.search(a.stage, a.phrase)
    if a.op == "open":
        search.open_result(*a.result)
    if a.op == "webapp":
        app = shutil.which("omarchy-launch-webapp-helium") or shutil.which(
            "omarchy-launch-webapp"
        )
        if not app:
            raise ValueError("Missing Omarchy web-app launcher")
        os.execl(app, app, "https://lycatra.com/", "--new-window")
    if a.op == "session-watch":
        return search.session_watch()
    if a.op == "serve":
        py = search.MODEL / "venv/bin/python"
        if py.exists() and Path(sys.prefix) != py.parents[1]:
            os.execv(py, [str(py), str(Path(__file__).resolve()), "serve"])
        return search.serve()
    if a.op == "configure":
        values = {}
        for key, paths in [("roots", a.root), ("exclude", a.exclude)]:
            if paths is not None:
                values[key] = [str(Path(v).expanduser().resolve()) for v in paths]
        for key in preferences.SWITCHES:
            value = getattr(a, key)
            if value is not None:
                values[key] = value == "on"
        cfg = preferences.update(values)
        return {k: v for k, v in cfg.items() if k != "wiki_session"}
    if a.op in ("pause", "resume"):
        return {"paused": preferences.update({"paused": a.op == "pause"})["paused"]}
    if a.op in ("status", "reindex"):
        with contextlib.closing(search.connect()) as db:
            search.initialize(db)
            if a.op == "reindex":
                with db:
                    db.execute("UPDATE files SET done=0")
                    db.execute("DELETE FROM passages")
            return dict(
                files=db.execute("SELECT count(*) FROM files").fetchone()[0],
                pending=db.execute(
                    "SELECT count(*) FROM files WHERE done=0"
                ).fetchone()[0],
                passages=db.execute("SELECT count(*) FROM passages").fetchone()[0],
                model=(
                    models.folder(
                        search.MODEL, search.settings().get("model", models.DEFAULT)
                    )
                    / "model.onnx"
                ).exists(),
                embedding_model=search.settings().get("model", models.DEFAULT),
                wiki=search.settings().get("wiki", False),
            )
    interactive_setup = a.op == "apply" and not a.components and sys.stdin.isatty()
    if interactive_setup:
        for key, component in manage.CAT.items():
            print(f"{key:12} {component['description']}", file=sys.stderr)
        a.components = input(
            "Choose components (space-separated), or studio for all: "
        ).split()
        if not a.components:
            raise ValueError("No components selected")
        plan = manage.manage("plan", a.components, True)
        print("Selected: " + ", ".join(plan["selected"]), file=sys.stderr)
        print("Files to change: " + str(len(plan["changes"])), file=sys.stderr)
        if plan["conflicts"]:
            raise ValueError(
                "Resolve conflicting paths: " + ", ".join(plan["conflicts"])
            )
        if input("Apply to this account? [y/N] ").strip().lower() != "y":
            return {"cancelled": True}
    elif a.op == "apply" and not a.components and not manage.RECEIPT.exists():
        raise ValueError("Choose components explicitly, or select studio")
    if a.op in ("apply", "update") and not a.stage:
        plan = manage.manage("plan", a.components, True)
        if plan["missing_commands"] and not plan["conflicts"]:
            packages = json.loads((manage.ROOT / "catalog.json").read_text())[
                "packages"
            ]
            wanted = sorted({packages[name] for name in plan["missing_commands"]})
            approved = a.install_deps or (
                sys.stdin.isatty()
                and input("Install " + ", ".join(wanted) + " with Omarchy? [y/N] ")
                .strip()
                .lower()
                == "y"
            )
            if approved:
                if "superwhisper-bin" in wanted:
                    subprocess.run(
                        [
                            "omarchy",
                            "install",
                            "dictation",
                            "superwhisper",
                            "--background",
                        ],
                        check=True,
                    )
                    wanted.remove("superwhisper-bin")
                if wanted:
                    subprocess.run(["omarchy", "pkg", "add", *wanted], check=True)
                plan = manage.manage("plan", a.components, True)
        if plan["missing_commands"] or plan["conflicts"]:
            raise ValueError(json.dumps(plan))
        if (
            "search" in plan["selected"]
            and not (search.MODEL / "tokenizer.json").exists()
        ):
            setup_model()
    if (
        a.op == "apply"
        and not a.stage
        and "search" in plan["selected"]
        and not search.CONFIG.exists()
    ):
        preferences.update({})
    result = manage.manage(a.op, a.components, a.stage)
    if (
        interactive_setup
        and not a.stage
        and "search" in result["selected"]
        and not search.settings().get("wiki")
    ):
        if not shutil.which("lycatra"):
            print(
                "For online wiki search, install the Lycatra CLI from https://lycatra.com/install.sh and run lycatra login.",
                file=sys.stderr,
            )
        elif not search.session_signature():
            print(
                "Sign in with lycatra login, then run lycatra-desktop configure --wiki on.",
                file=sys.stderr,
            )
        elif (
            input(
                "Include wiki results? This sends typed search phrases to Lycatra. [y/N] "
            )
            .strip()
            .lower()
            == "y"
        ):
            cfg = search.settings()
            manage.save(
                search.CONFIG,
                {**cfg, "wiki": True, "wiki_session": search.session_signature()},
            )
    if a.op == "verify" and (
        result.get("inactive")
        or result["changes"]
        or result["conflicts"]
        or (result["missing_commands"] and not a.stage)
    ):
        print(json.dumps(result))
        raise SystemExit(1)
    return result


if __name__ == "__main__":
    try:
        result = main()
        if result is not None:
            print(json.dumps(result, ensure_ascii=True))
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
