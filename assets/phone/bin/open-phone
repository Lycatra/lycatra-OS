#!/usr/bin/python
import ipaddress
import json
import shlex
import subprocess
import sys


def hypr_json(command):
    return json.loads(subprocess.check_output(["hyprctl", "-j", command]))


def dispatch(command):
    subprocess.run(["hyprctl", "dispatch", command], check=True)


def main():
    monitor_name, endpoint, title = sys.argv[1:]
    address, port = endpoint.rsplit(":", 1)
    ipaddress.IPv4Address(address)
    if not (1 <= int(port) <= 65535 and port.isdecimal() and title.isprintable()):
        raise ValueError("Invalid remote phone configuration")

    monitors = hypr_json("monitors")
    monitor = next((item for item in monitors if item["name"] == monitor_name), None)
    if monitor is None:
        monitor = next(item for item in monitors if item["focused"])

    workspace = json.dumps(str(monitor["activeWorkspace"]["id"]))
    monitor_name = json.dumps(monitor["name"])
    for window in hypr_json("clients"):
        if window["class"] != "scrcpy" or window["title"] != title:
            continue

        selector = json.dumps("address:" + window["address"])
        dispatch(f'hl.dsp.window.float({{action = "on", window = {selector}}})')
        if window["workspace"]["id"] != monitor["activeWorkspace"]["id"]:
            dispatch(f"hl.dsp.window.move({{workspace = {workspace}, follow = false, window = {selector}}})")
        dispatch(f"hl.dsp.window.center({{window = {selector}}})")
        dispatch(f"hl.dsp.focus({{window = {selector}}})")
        return

    monitor_height = monitor["width"] if monitor["transform"] % 2 else monitor["height"]
    height = min(720, int(monitor_height / monitor["scale"] * 0.75))
    command = json.dumps(shlex.join([
        "scrcpy", f"--tcpip={endpoint}", f"--window-title={title}", f"--window-height={height}",
    ]), ensure_ascii=False)
    dispatch(f"hl.dsp.exec_cmd({command}, {{float = true, center = true, monitor = {monitor_name}, workspace = {workspace}}})")


if __name__ == "__main__":
    main()
