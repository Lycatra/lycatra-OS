#!/usr/bin/python
import os
import json
import re
import subprocess
import sys

from phone_cache import PIXEL as PIXEL_ID, PhoneCache

PIXEL = os.environ.get("LYCATRA_PHONE_ADB", "")


def adb(command):
    return subprocess.check_output(["adb", "-s", PIXEL, "shell", command],
                                   text=True, timeout=12, stderr=subprocess.STDOUT)



def number_key(number):
    digits = re.sub(r"\D", "", number)
    if number.lstrip().startswith("00"):
        digits = digits[2:]
    if len(digits) == 11 and digits.startswith("41"):
        return "0" + digits[2:]
    return digits


def unique_numbers(entries):
    unique = {}
    for entry in entries:
        key = number_key(entry["number"])
        previous = unique.get(key)
        if previous is None:
            unique[key] = entry.copy()
        elif previous["label"] == "Phone" and entry["label"] != "Phone":
            previous["label"] = entry["label"]
    return list(unique.values())


def load():
    contacts = {}
    labels = {
        1: "Home", 2: "Mobile", 3: "Work", 4: "Work fax", 5: "Home fax",
        6: "Pager", 7: "Other", 8: "Callback", 9: "Car", 10: "Company main",
        11: "ISDN", 12: "Main", 13: "Other fax", 14: "Radio", 15: "Telex",
        16: "TTY", 17: "Work mobile", 18: "Work pager", 19: "Assistant", 20: "MMS",
    }
    for row in adb("content query --uri content://com.android.contacts/data/phones "
                   "--projection contact_id:display_name:data1:data2:data3").splitlines():
        entry = re.fullmatch(r"Row: \d+ contact_id=(\d+), display_name=(.*), data1=(.*), data2=(\d+|NULL), data3=(.*)", row)
        if not entry:
            continue
        contact_id, name, number, kind, custom = entry.groups()
        if not re.fullmatch(r"[+0-9 ()/.\-]{2,45}", number):
            continue
        digits = re.sub(r"\D", "", number)
        if not digits:
            continue
        contact = contacts.setdefault(contact_id, {
            "id": contact_id, "name": (name if name != "NULL" else number)[:160], "numbers": [],
        })
        label = custom[:80] if custom not in ("", "NULL") else labels.get(int(kind) if kind != "NULL" else 0, "Phone")
        contact["numbers"].append({"number": number, "label": label})
    for contact in contacts.values():
        contact["numbers"] = unique_numbers(contact["numbers"])
    calls = []
    for row in adb("content query --uri content://call_log/calls --projection number:date:type:duration --sort 'date DESC' | head -300").splitlines():
        entry = re.fullmatch(r"Row: \d+ number=(.*), date=(\d+), type=(\d+), duration=(\d+)", row)
        if not entry:
            continue
        number, date, kind, duration = entry.groups()
        if not re.fullmatch(r"[+0-9 ()/.\-]{2,45}", number):
            continue
        calls.append({"number": number, "date": int(date), "kind": int(kind), "duration": int(duration)})
    if not contacts and not calls:
        raise ValueError("The Pixel did not return contacts or recent calls.")
    return {"contacts": sorted(contacts.values(), key=lambda row: row["name"].casefold()), "calls": calls}


if __name__ == "__main__":
    cache = PhoneCache(PIXEL_ID)
    saved = cache.phonebook()
    if saved:
        for contact in saved["contacts"]:
            contact["numbers"] = unique_numbers(contact["numbers"])
        cache.save_phonebook(saved)
        print(json.dumps({"cached": True, **saved}), flush=True)
    if "--cached" in sys.argv:
        sys.exit(0)
    try:
        fresh = load()
        cache.save_phonebook(fresh)
        print(json.dumps(fresh), flush=True)
    except (subprocess.SubprocessError, OSError, ValueError):
        print(json.dumps({"error": "Could not load phone data. Check the Pixel’s wireless connection."}))
        sys.exit(1)
